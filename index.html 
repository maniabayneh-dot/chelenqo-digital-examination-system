<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#123c69">
<title>Chelenqo Digital Examination System</title>
<style>
:root{--navy:#123c69;--blue:#1769aa;--green:#15803d;--red:#b91c1c;--bg:#f1f5f9;--ink:#172554}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--ink)}
header{background:var(--navy);color:white;text-align:center;padding:22px 12px}
header h1{margin:5px;font-size:clamp(20px,4vw,28px)}
header p{margin:6px}
nav{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;padding:12px;background:#e2e8f0}
button{border:0;border-radius:7px;padding:12px 16px;background:var(--blue);color:white;font-size:15px;cursor:pointer;margin:3px}
button:disabled{background:#94a3b8;cursor:not-allowed}
button.primary{background:var(--green)}
button.danger{background:var(--red)}
button.secondary{background:#475569}
.container{max-width:900px;margin:22px auto;padding:0 14px}
.card{background:white;padding:20px;border-radius:12px;box-shadow:0 3px 12px #00000012;margin-bottom:18px}
.hidden{display:none!important}
label{display:block;font-weight:600;margin:12px 0 5px}
input,select,textarea{display:block;width:100%;padding:12px;margin:6px 0 12px;border:1px solid #cbd5e1;border-radius:7px;font-size:16px;background:white}
textarea{min-height:220px;font-family:monospace;font-size:14px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.info{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-weight:bold}
#timer{color:var(--red);font-size:20px}
.question{font-size:19px;font-weight:bold;margin:20px 0}
.option{display:block;background:#f1f5f9;border:1px solid #cbd5e1;border-radius:7px;padding:13px;margin:10px 0;cursor:pointer;font-weight:normal}
.option input{display:inline-block;width:auto;margin:0 10px 0 0}
.notice{padding:12px;border-radius:8px;background:#fff7ed;color:#9a3412;line-height:1.5}
.muted{color:#64748b;font-size:14px}
.item{padding:12px;border:1px solid #e2e8f0;border-radius:8px;margin:9px 0}
footer{text-align:center;padding:20px;color:#64748b}
@media(max-width:520px){.card{padding:15px}button{padding:11px 12px}}
</style>
</head>
<body>
<header>
  <h1>CHELENQO SECONDARY SCHOOL</h1>
  <p>Digital Examination System</p>
  <p>Grades 9–12 | Student Examinations and Teacher Dashboard</p>
</header>

<nav>
  <button type="button" id="studentTab">Student Examination</button>
  <button type="button" id="teacherTab" class="secondary">Teacher / Admin Dashboard</button>
  <button type="button" id="resultsTab" class="secondary">Saved Results</button>
</nav>

<main class="container">
  <section id="studentPanel" class="card">
    <h2>Student Registration</h2>
    <p>Enter your details and select the examination assigned to your grade.</p>
    <form id="studentForm">
      <div class="grid">
        <div><label for="studentName">Full name</label><input id="studentName" required autocomplete="name"></div>
        <div><label for="studentId">Student ID</label><input id="studentId" required></div>
        <div><label for="grade">Grade</label>
          <select id="grade" required>
            <option value="">Select grade</option><option value="9">Grade 9</option>
            <option value="10">Grade 10</option><option value="11">Grade 11</option>
            <option value="12">Grade 12</option>
          </select>
        </div>
        <div><label for="section">Section</label><input id="section" placeholder="e.g. A" required></div>
        <div><label for="subject">Subject</label><select id="subject" required disabled><option value="">First select grade</option></select></div>
        <div><label for="examSelect">Available examination</label><select id="examSelect" required disabled><option value="">Select grade and subject first</option></select></div>
        <div><label for="schoolCode">School examination code</label><input id="schoolCode" required autocomplete="off"></div>
      </div>
      <button type="submit" class="primary">Start Examination</button>
      <p id="registrationMessage" role="alert"></p>
    </form>
  </section>

  <section id="examPanel" class="card hidden">
    <div class="info"><span id="studentDisplay"></span><span id="timer">00:00</span></div>
    <hr>
    <div class="info"><span id="questionNumber"></span><span id="answeredCount"></span></div>
    <p id="questionText" class="question"></p>
    <div id="options"></div>
    <hr>
    <button type="button" id="previousBtn" class="secondary">Previous</button>
    <button type="button" id="nextBtn">Next</button>
    <button type="button" id="submitBtn" class="danger">Submit Examination</button>
  </section>

  <section id="resultPanel" class="card hidden">
    <h2>Examination Result</h2>
    <p id="resultStudent"></p><p id="resultExam"></p>
    <h3 id="score"></h3><h3 id="percentage"></h3>
    <p id="resultMessage"></p>
    <button type="button" id="returnHome" class="primary">Return to Home</button>
  </section>

  <section id="teacherPanel" class="card hidden">
    <h2>Teacher / Administrator Dashboard</h2>
    <p class="notice"><strong>Prototype notice:</strong> This first version saves exams and results only in this browser. It has no secure teacher login or shared database. Do not use it for real confidential examinations until Supabase authentication and database security are connected.</p>
    <h3>Create an examination</h3>
    <form id="examForm">
      <div class="grid">
        <div><label for="examGrade">Grade</label>
          <select id="examGrade" required><option value="">Select grade</option><option value="9">Grade 9</option><option value="10">Grade 10</option><option value="11">Grade 11</option><option value="12">Grade 12</option></select>
        </div>
        <div><label for="examSubject">Subject</label><select id="examSubject" required disabled><option value="">First select grade</option></select></div>
        <div><label for="examTitle">Examination title</label><input id="examTitle" placeholder="e.g. Unit 1 Assessment" required></div>
        <div><label for="examDuration">Duration (minutes)</label><input id="examDuration" type="number" min="1" max="240" value="60" required></div>
      </div>
      <label for="questionsJson">Questions (JSON format)</label>
      <textarea id="questionsJson" required spellcheck="false">[
  {
    "question": "Why do atoms share electrons in covalent bonds?",
    "options": [
      "To achieve a more stable electron configuration",
      "To increase their atomic mass",
      "To become positively charged",
      "To lose all their electrons"
    ],
    "answer": 0
  },
  {
    "question": "Which of the following is a strong acid?",
    "options": ["CH3COOH", "HCl", "H2CO3", "HF"],
    "answer": 1
  }
]</textarea>
      <p class="muted">Each question needs a question, an options array, and an answer index. The first option is index 0, the second is 1, the third is 2, and the fourth is 3.</p>
      <button type="submit" class="primary">Save Examination</button>
      <p id="teacherMessage" role="status"></p>
    </form>
    <hr>
    <h3>Published examinations on this device</h3>
    <div id="examList"></div>
  </section>

  <section id="resultsPanel" class="card hidden">
    <h2>Saved Examination Results</h2>
    <p class="notice">These results are stored in this browser only in this prototype.</p>
    <div id="resultsList"></div>
  </section>
</main>

<footer>&copy; 2026 Chelenqo Secondary School</footer>

<script>
"use strict";

const subjectsByGrade = {
  "9": ["Mathematics","English","Physics","Chemistry","Biology","Geography","History","Civics","ICT","Afaan Oromo","Amharic"],
  "10": ["Mathematics","English","Physics","Chemistry","Biology","Geography","History","Civics","ICT","Afaan Oromo","Amharic"],
  "11": ["Mathematics","English","Physics","Chemistry","Biology","Geography","History","Economics","ICT","Afaan Oromo","Amharic"],
  "12": ["Mathematics","English","Physics","Chemistry","Biology","Geography","History","Economics","ICT","Afaan Oromo","Amharic"]
};

const STORAGE_EXAMS = "chelenqo_exams_v1";
const STORAGE_RESULTS = "chelenqo_results_v1";

const sampleExam = {
  id: "sample-grade12-chemistry",
  grade: "12",
  subject: "Chemistry",
  title: "Grade 12 Chemistry Sample Examination",
  duration: 60,
  questions: [
    {question:"Why do atoms share electrons in covalent bonds?",options:["To achieve a more stable electron configuration","To increase their atomic mass","To become positively charged","To lose all their electrons"],answer:0},
    {question:"Which of the following is a strong acid?",options:["CH3COOH","HCl","H2CO3","HF"],answer:1},
    {question:"What is the pH of a neutral solution at 25°C?",options:["1","5","7","14"],answer:2},
    {question:"Which ion makes an aqueous NaF solution basic?",options:["Na+","F-","H+","Cl-"],answer:1},
    {question:"Which theory explains molecular shape?",options:["Kinetic molecular theory","VSEPR theory","Collision theory","Atomic theory"],answer:1}
  ]
};

function loadArray(key, fallback) {
  try {
    const parsed = JSON.parse(localStorage.getItem(key));
    return Array.isArray(parsed) ? parsed : fallback;
  } catch (error) {
    return fallback;
  }
}
let exams = loadArray(STORAGE_EXAMS, [sampleExam]);
let results = loadArray(STORAGE_RESULTS, []);
if (!exams.some(exam => exam.id === sampleExam.id)) exams.unshift(sampleExam);

let student = null;
let activeExam = null;
let currentQuestion = 0;
let answers = [];
let secondsLeft = 0;
let timerHandle = null;
let submitted = false;

const $ = id => document.getElementById(id);
const panels = ["studentPanel","examPanel","resultPanel","teacherPanel","resultsPanel"];

function showPanel(panelId) {
  panels.forEach(id => $(id).classList.toggle("hidden", id !== panelId));
  $("studentTab").classList.toggle("secondary", panelId !== "studentPanel");
  $("teacherTab").classList.toggle("secondary", panelId !== "teacherPanel");
  $("resultsTab").classList.toggle("secondary", panelId !== "resultsPanel");
}
function saveExams() {
  localStorage.setItem(STORAGE_EXAMS, JSON.stringify(exams));
}
function saveResults() {
  localStorage.setItem(STORAGE_RESULTS, JSON.stringify(results));
}
function fillSubjects(gradeId, subjectId) {
  const grade = $(gradeId).value;
  const select = $(subjectId);
  select.innerHTML = '<option value="">Select subject</option>';
  (subjectsByGrade[grade] || []).forEach(subject => {
    const option = document.createElement("option");
    option.value = subject;
    option.textContent = subject;
    select.appendChild(option);
  });
  select.disabled = !grade;
}
function fillAvailableExams() {
  const grade = $("grade").value;
  const subject = $("subject").value;
  const select = $("examSelect");
  select.innerHTML = '<option value="">Select examination</option>';
  exams.filter(e => e.grade === grade && e.subject === subject).forEach(exam => {
    const option = document.createElement("option");
    option.value = exam.id;
    option.textContent = exam.title;
    select.appendChild(option);
  });
  select.disabled = !grade || !subject || select.options.length === 1;
  if (select.disabled) select.innerHTML = '<option value="">No examination available</option>';
}

$("grade").addEventListener("change", () => {
  fillSubjects("grade","subject");
  $("examSelect").innerHTML = '<option value="">Select subject first</option>';
  $("examSelect").disabled = true;
});
$("subject").addEventListener("change", fillAvailableExams);
$("examGrade").addEventListener("change", () => fillSubjects("examGrade","examSubject"));

$("studentForm").addEventListener("submit", event => {
  event.preventDefault();
  const exam = exams.find(e => e.id === $("examSelect").value);
  if (!exam) {
    $("registrationMessage").textContent = "No examination is available for this grade and subject.";
    return;
  }
  student = {
    name: $("studentName").value.trim(),
    id: $("studentId").value.trim(),
    grade: $("grade").value,
    section: $("section").value.trim(),
    subject: $("subject").value,
    schoolCode: $("schoolCode").value.trim()
  };
  if (Object.values(student).some(value => !value)) {
    $("registrationMessage").textContent = "Please complete all registration fields.";
    return;
  }
  activeExam = exam;
  currentQuestion = 0;
  answers = new Array(activeExam.questions.length).fill(null);
  secondsLeft = Number(activeExam.duration) * 60;
  submitted = false;
  $("studentDisplay").textContent = `${student.name} | Grade ${student.grade} | ${student.subject}`;
  showPanel("examPanel");
  renderQuestion();
  updateTimer();
  clearInterval(timerHandle);
  timerHandle = setInterval(() => {
    secondsLeft--;
    updateTimer();
    if (secondsLeft <= 0) finishExam(true);
  }, 1000);
});

function updateTimer() {
  const mins = Math.floor(secondsLeft / 60);
  const secs = secondsLeft % 60;
  $("timer").textContent = `${String(mins).padStart(2,"0")}:${String(secs).padStart(2,"0")}`;
}
function renderQuestion() {
  const q = activeExam.questions[currentQuestion];
  $("questionNumber").textContent = `Question ${currentQuestion + 1} of ${activeExam.questions.length}`;
  $("answeredCount").textContent = `Answered: ${answers.filter(a => a !== null).length}`;
  $("questionText").textContent = q.question;
  const optionsBox = $("options");
  optionsBox.innerHTML = "";
  q.options.forEach((optionText,index) => {
    const label = document.createElement("label");
    label.className = "option";
    const radio = document.createElement("input");
    radio.type = "radio";
    radio.name = "answer";
    radio.value = String(index);
    radio.checked = answers[currentQuestion] === index;
    radio.addEventListener("change", () => {
      answers[currentQuestion] = index;
      renderQuestion();
    });
    label.appendChild(radio);
    label.appendChild(document.createTextNode(`${String.fromCharCode(65 + index)}. ${optionText}`));
    optionsBox.appendChild(label);
  });
  $("previousBtn").disabled = currentQuestion === 0;
  $("nextBtn").disabled = currentQuestion === activeExam.questions.length - 1;
}
$("previousBtn").addEventListener("click", () => {
  if (currentQuestion > 0) { currentQuestion--; renderQuestion(); }
});
$("nextBtn").addEventListener("click", () => {
  if (currentQuestion < activeExam.questions.length - 1) { currentQuestion++; renderQuestion(); }
});
$("submitBtn").addEventListener("click", () => {
  const unanswered = answers.filter(a => a === null).length;
  if (unanswered && !confirm(`${unanswered} question(s) are unanswered. Submit anyway?`)) return;
  finishExam(false);
});

function finishExam(timeExpired) {
  if (submitted || !activeExam || !student) return;
  submitted = true;
  clearInterval(timerHandle);
  const marks = activeExam.questions.reduce((total,q,index) => total + (answers[index] === Number(q.answer) ? 1 : 0),0);
  const total = activeExam.questions.length;
  const percent = total ? marks / total * 100 : 0;
  const result = {
    studentName: student.name,
    studentId: student.id,
    grade: student.grade,
    section: student.section,
    subject: student.subject,
    examTitle: activeExam.title,
    marks, total,
    percentage: Number(percent.toFixed(1)),
    submittedAt: new Date().toLocaleString()
  };
  results.unshift(result);
  try { saveResults(); } catch (error) { alert("Could not save result in this browser. Storage may be full."); }
  $("resultStudent").textContent = `Student: ${student.name} | ID: ${student.id} | Grade ${student.grade} ${student.section}`;
  $("resultExam").textContent = `${activeExam.subject} — ${activeExam.title}`;
  $("score").textContent = `Score: ${marks} / ${total}`;
  $("percentage").textContent = `Percentage: ${percent.toFixed(1)}%`;
  $("resultMessage").textContent = timeExpired ? "Time expired. Your answers were submitted automatically." : "Examination submitted successfully.";
  showPanel("resultPanel");
}
$("returnHome").addEventListener("click", () => {
  $("studentForm").reset();
  $("subject").innerHTML = '<option value="">First select grade</option>';
  $("subject").disabled = true;
  $("examSelect").innerHTML = '<option value="">Select grade and subject first</option>';
  $("examSelect").disabled = true;
  $("registrationMessage").textContent = "";
  showPanel("studentPanel");
});

$("examForm").addEventListener("submit", event => {
  event.preventDefault();
  const grade = $("examGrade").value;
  const subject = $("examSubject").value;
  const title = $("examTitle").value.trim();
  const duration = Number($("examDuration").value);
  let questions;
  try {
    questions = JSON.parse($("questionsJson").value);
  } catch (error) {
    $("teacherMessage").textContent = "Invalid JSON. Check commas, quotation marks and brackets.";
    return;
  }
  if (!grade || !subject || !title || !Number.isInteger(duration) || duration < 1 || duration > 240) {
    $("teacherMessage").textContent = "Complete all fields. Duration must be 1–240 minutes.";
    return;
  }
  if (!Array.isArray(questions) || questions.length < 1) {
    $("teacherMessage").textContent = "Add at least one question.";
    return;
  }
  const valid = questions.every(q =>
    q && typeof q.question === "string" && q.question.trim() &&
    Array.isArray(q.options) && q.options.length >= 2 &&
    q.options.every(option => typeof option === "string" && option.trim()) &&
    Number.isInteger(q.answer) && q.answer >= 0 && q.answer < q.options.length
  );
  if (!valid) {
    $("teacherMessage").textContent = "Question format is incorrect. Each answer must be a valid zero-based option index.";
    return;
  }
  exams.unshift({id:`exam-${Date.now()}`,grade,subject,title,duration,questions});
  try {
    saveExams();
    $("teacherMessage").textContent = "Examination saved on this device.";
    $("examForm").reset();
    $("examDuration").value = "60";
    $("examSubject").innerHTML = '<option value="">First select grade</option>';
    $("examSubject").disabled = true;
    renderExamList();
  } catch (error) {
    $("teacherMessage").textContent = "Could not save. Browser storage may be full.";
  }
});
function renderExamList() {
  const box = $("examList");
  box.innerHTML = "";
  if (!exams.length) { box.textContent = "No examinations created yet."; return; }
  exams.forEach(exam => {
    const item = document.createElement("div");
    item.className = "item";
    const title = document.createElement("strong");
    title.textContent = `Grade ${exam.grade} — ${exam.subject}: ${exam.title}`;
    const details = document.createElement("p");
    details.className = "muted";
    details.textContent = `${exam.questions.length} questions | ${exam.duration} minutes`;
    item.append(title,details);
    if (exam.id !== sampleExam.id) {
      const del = document.createElement("button");
      del.type = "button";
      del.className = "danger";
      del.textContent = "Delete";
      del.addEventListener("click", () => {
        if (confirm(`Delete "${exam.title}"?`)) {
          exams = exams.filter(e => e.id !== exam.id);
          saveExams();
          renderExamList();
        }
      });
      item.appendChild(del);
    }
    box.appendChild(item);
  });
}
function renderResults() {
  const box = $("resultsList");
  box.innerHTML = "";
  if (!results.length) { box.textContent = "No saved results on this device yet."; return; }
  results.forEach(r => {
    const item = document.createElement("div");
    item.className = "item";
    const heading = document.createElement("strong");
    heading.textContent = `${r.studentName} (${r.studentId}) — Grade ${r.grade} ${r.section}`;
    const detail = document.createElement("p");
    detail.textContent = `${r.subject} | ${r.examTitle} | ${r.marks}/${r.total} (${r.percentage}%)`;
    const date = document.createElement("p");
    date.className = "muted";
    date.textContent = r.submittedAt;
    item.append(heading,detail,date);
    box.appendChild(item);
  });
}
$("studentTab").addEventListener("click", () => showPanel("studentPanel"));
$("teacherTab").addEventListener("click", () => { renderExamList(); showPanel("teacherPanel"); });
$("resultsTab").addEventListener("click", () => { renderResults(); showPanel("resultsPanel"); });

renderExamList();
</script>
</body>
</html>
